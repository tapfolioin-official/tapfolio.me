    <path
        android:fillColor="#1A5C6BC0"
        android:pathData="M54,18 A36,36 0 1,1 53.99,18 Z"/>

    <!-- Outer indigo ring -->
    <path
        android:fillColor="#FF5C6BC0"
        android:pathData="M54,22 A32,32 0 1,1 53.99,22 Z"/>

    <!-- Inner dark background circle -->
    <path
        android:fillColor="#FF0F0F16"
        android:pathData="M54,28 A26,26 0 1,1 53.99,28 Z"/>

    <!-- "T" letter — horizontal bar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,42 L72,42 L72,48 L36,48 Z"/>

    <!-- "T" letter — vertical stem -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M50,48 L58,48 L58,72 L50,72 Z"/>

