<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        LaunchTheme: applied immediately while the Flutter engine starts.
        Uses Tapfolio's dark #0F0F16 background to match the app's dark theme.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!--
        NormalTheme: applied after Flutter draws its first frame.
        Keeps the same dark background so there's no flash of white.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/colorBackground</item>
    </style>
</resources>
