<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ Data Extraction Rules for Tapfolio.
    Prevents cloud backup of sensitive authentication tokens.
    https://developer.android.com/guide/topics/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all SharedPreferences (contains JWT tokens) -->
        <exclude domain="sharedpref" path="."/>
        <!-- Exclude the app's internal data directory -->
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
    </cloud-backup>

    <device-transfer>
        <!-- Exclude authentication tokens from device-to-device transfer -->
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
